{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-featured-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: 600px;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 600px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-featured-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.featured_text_color }};
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
    font-weight: 600;
    color: {{ block.settings.category_color }};
  }

  .ai-editorial-featured-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
    line-height: 1.2;
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-editorial-featured-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_excerpt_size }}px;
    line-height: 1.6;
    margin: 0 0 20px;
    max-width: 600px;
  }

  .ai-editorial-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    opacity: 0.9;
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-editorial-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 280px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-card-content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-editorial-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    line-height: 1.3;
    margin: 0 0 12px;
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
  }

  .ai-editorial-card-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_excerpt_size }}px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: {{ block.settings.card_text_color }};
    opacity: 0.8;
  }

  .ai-editorial-card-meta-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.card_text_color }};
    opacity: 0.7;
  }

  .ai-editorial-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-editorial-link-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-featured-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} {
      grid-column: span 12;
      flex-direction: row;
      overflow-x: auto;
    }

    .ai-editorial-card-{{ ai_gen_id }} {
      min-width: 300px;
    }

    .ai-editorial-featured-image-{{ ai_gen_id }},
    .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
      height: 400px;
    }

    .ai-editorial-featured-content-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-editorial-featured-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.featured_title_size | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-editorial-featured-image-{{ ai_gen_id }},
    .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
      height: 300px;
    }

    .ai-editorial-featured-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.featured_title_size | times: 0.6 }}px;
    }

    .ai-editorial-card-image-{{ ai_gen_id }},
    .ai-editorial-card-placeholder-{{ ai_gen_id }} {
      height: 200px;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }} class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-container-{{ ai_gen_id }}">
    <div class="ai-editorial-grid-{{ ai_gen_id }}">
      <div class="ai-editorial-featured-{{ ai_gen_id }}">
        {% if block.settings.featured_article %}
          <a href="{{ block.settings.featured_article.url }}" class="ai-editorial-link-{{ ai_gen_id }}">
            {% if block.settings.featured_article.image %}
              <img
                src="{{ block.settings.featured_article.image | image_url: width: 1200 }}"
                alt="{{ block.settings.featured_article.image.alt | escape }}"
                class="ai-editorial-featured-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.featured_article.image.width }}"
                height="{{ block.settings.featured_article.image.height }}"
              >
            {% else %}
              <div class="ai-editorial-featured-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-editorial-featured-content-{{ ai_gen_id }}">
              {% if block.settings.show_category and block.settings.featured_article.tags.size > 0 %}
                <div class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.featured_article.tags.first }}</div>
              {% endif %}
              <h2 class="ai-editorial-featured-title-{{ ai_gen_id }}">{{ block.settings.featured_article.title }}</h2>
              {% if block.settings.show_excerpt %}
                <div class="ai-editorial-featured-excerpt-{{ ai_gen_id }}">
                  {{ block.settings.featured_article.excerpt_or_content | strip_html | truncate: 180 }}
                </div>
              {% endif %}
              {% if block.settings.show_meta %}
                <div class="ai-editorial-meta-{{ ai_gen_id }}">
                  {% if block.settings.featured_article.author %}
                    <span>{{ block.settings.featured_article.author }}</span>
                  {% endif %}
                  <span>{{ block.settings.featured_article.published_at | date: '%B %d, %Y' }}</span>
                </div>
              {% endif %}
            </div>
          </a>
        {% else %}
          <div class="ai-editorial-featured-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
          <div class="ai-editorial-featured-content-{{ ai_gen_id }}">
            <div class="ai-editorial-category-{{ ai_gen_id }}">Featured</div>
            <h2 class="ai-editorial-featured-title-{{ ai_gen_id }}">Select a featured article</h2>
            <div class="ai-editorial-featured-excerpt-{{ ai_gen_id }}">
              Choose an article from your blog to showcase as the main feature of this editorial layout.
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-editorial-sidebar-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign article_key = 'article_' | append: i
            assign article = block.settings[article_key]
          %}
          <div class="ai-editorial-card-{{ ai_gen_id }}">
            {% if article %}
              <a href="{{ article.url }}" class="ai-editorial-link-{{ ai_gen_id }}">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.image.alt | escape }}"
                    class="ai-editorial-card-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                  >
                {% else %}
                  <div class="ai-editorial-card-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-editorial-card-content-{{ ai_gen_id }}">
                  {% if block.settings.show_category and article.tags.size > 0 %}
                    <div class="ai-editorial-category-{{ ai_gen_id }}">{{ article.tags.first }}</div>
                  {% endif %}
                  <h3 class="ai-editorial-card-title-{{ ai_gen_id }}">{{ article.title }}</h3>
                  {% if block.settings.show_excerpt %}
                    <div class="ai-editorial-card-excerpt-{{ ai_gen_id }}">
                      {{ article.excerpt_or_content | strip_html | truncate: 100 }}
                    </div>
                  {% endif %}
                  {% if block.settings.show_meta %}
                    <div class="ai-editorial-card-meta-{{ ai_gen_id }}">
                      {{ article.published_at | date: '%b %d, %Y' }}
                    </div>
                  {% endif %}
                </div>
              </a>
            {% else %}
              <div class="ai-editorial-card-placeholder-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
              <div class="ai-editorial-card-content-{{ ai_gen_id }}">
                <div class="ai-editorial-category-{{ ai_gen_id }}">Article {{ i }}</div>
                <h3 class="ai-editorial-card-title-{{ ai_gen_id }}">Select article {{ i }}</h3>
                <div class="ai-editorial-card-excerpt-{{ ai_gen_id }}">
                  Choose an article to display in this card position.
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('.ai-editorial-link-{{ ai_gen_id }}');
        links.forEach(link => {
          link.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Magazine editorial layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Featured article"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article"
    },
    {
      "type": "header",
      "content": "Additional articles"
    },
    {
      "type": "article",
      "id": "article_1",
      "label": "Article 1"
    },
    {
      "type": "article",
      "id": "article_2",
      "label": "Article 2"
    },
    {
      "type": "article",
      "id": "article_3",
      "label": "Article 3"
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show metadata",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "featured_title_size",
      "label": "Featured title size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "featured_excerpt_size",
      "label": "Featured excerpt size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_excerpt_size",
      "label": "Card excerpt size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "featured_text_color",
      "label": "Featured text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Category tag",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Featured overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.7
    }
  ],
  "presets": [
    {
      "name": "Magazine editorial layout"
    }
  ]
}
{% endschema %}
