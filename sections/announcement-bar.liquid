{% comment %}
  Section: Announcement Bar
  File: sections/announcement-bar.liquid

  Renders rotating promos for the active market (localization country/currency).
  Block types: us, cad, uk, eur, bulgaria, czech_republic, denmark, hungary, poland, romania, sweden, aud, nzd.
  Legacy US types: announcement_us, announcement.

  Stores: none (Alpine local state: idx, total, interval)
  CSS API: .announcement-bar, .announcement-bar__content, .announcement-bar__message, .announcement-bar__slide, .announcement-bar__text
  Sets: --announcement-bar-height via inline script + ResizeObserver
{% endcomment %}

{% liquid
  assign country_iso = localization.country.iso_code | upcase
  assign currency_iso = localization.country.currency.iso_code | upcase
  assign announcement_market_type = 'us'

  case country_iso
    when 'CA'
      assign announcement_market_type = 'cad'
    when 'GB'
      assign announcement_market_type = 'uk'
    when 'AU'
      assign announcement_market_type = 'aud'
    when 'NZ'
      assign announcement_market_type = 'nzd'
    when 'BG'
      assign announcement_market_type = 'bulgaria'
    when 'CZ'
      assign announcement_market_type = 'czech_republic'
    when 'DK'
      assign announcement_market_type = 'denmark'
    when 'HU'
      assign announcement_market_type = 'hungary'
    when 'PL'
      assign announcement_market_type = 'poland'
    when 'RO'
      assign announcement_market_type = 'romania'
    when 'SE'
      assign announcement_market_type = 'sweden'
    when 'US'
      assign announcement_market_type = 'us'
  endcase

  if announcement_market_type == 'us' and currency_iso == 'EUR'
    assign announcement_market_type = 'eur'
  endif

  assign visible_count = 0

  for block in section.blocks
    assign block_market_key = block.type
    if block.type == 'announcement_us' or block.type == 'announcement'
      assign block_market_key = 'us'
    endif

    if block_market_key == announcement_market_type and block.settings.text != blank
      assign visible_count = visible_count | plus: 1
    endif
  endfor

  if visible_count == 0 and announcement_market_type != 'us'
    assign announcement_market_type = 'us'
    assign visible_count = 0

    for block in section.blocks
      assign block_market_key = block.type
      if block.type == 'announcement_us' or block.type == 'announcement'
        assign block_market_key = 'us'
      endif

      if block_market_key == 'us' and block.settings.text != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .announcement-bar-section {
    width: 100%;
    position: relative;
  }

  .announcement-bar {
    padding-block: 7px;
    text-align: center;
  }

  .announcement-bar__content {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    position: relative;
  }

  .announcement-bar__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    transition: opacity 0.2s ease, background-color 0.2s ease;
    flex-shrink: 0;
  }

  .announcement-bar__arrow svg {
    width: 13px;
    height: 13px;
    display: block;
    flex-shrink: 0;
  }

  .announcement-bar__arrow:hover {
    opacity: 0.7;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .announcement-bar__arrow:active {
    transform: scale(0.95);
  }

  .announcement-bar__message {
    flex: 1;
    min-width: 0;
    margin: 0;
    display: grid;
    align-items: center;
    justify-items: center;
  }

  .announcement-bar__slide {
    grid-area: 1 / 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    visibility: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .announcement-bar__slide--active {
    visibility: visible;
    pointer-events: auto;
    z-index: 1;
  }

  .announcement-bar__text {
    font-family: 'Articulat CF', sans-serif;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .announcement-bar__text p {
    margin: 0;
  }

  .announcement-bar__text strong,
  .announcement-bar__text b {
    font-weight: 700;
  }

  .announcement-bar__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
    text-decoration-thickness: 0.1rem;
    transition: text-decoration-thickness 0.2s ease;
  }

  .announcement-bar__text a:hover {
    text-decoration-thickness: 0.2rem;
  }

  .announcement-bar__text--mobile {
    display: none;
  }

  .announcement-bar__slide--active.fade-in {
    animation: announcementFadeSlide 0.3s ease-in-out;
  }

  @keyframes announcementFadeSlide {
    from {
      opacity: 0;
      transform: translateX(1.2rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__slide--active.fade-in {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .announcement-bar__content {
      gap: 0;
    }

    .announcement-bar__arrow {
      display: none;
    }

    .announcement-bar__text {
      font-size: 1.3rem;
    }

    .announcement-bar__text--desktop:has(+ .announcement-bar__text--mobile) {
      display: none;
    }

    .announcement-bar__text--mobile {
      display: block;
    }
  }
{% endstyle %}

{% if section.settings.show_announcement and visible_count > 0 %}
  <section class="announcement-bar-section">
    <div
      class="announcement-bar"
      x-data="
        {
          idx: 0,
          total: {{ visible_count }},
          interval: null,
          startAutoScroll() {
            if (this.total > 1) {
              this.interval = setInterval(() => {
                this.idx = (this.idx + 1) % this.total;
              }, ({{ section.settings.auto_rotate_interval | default: 4 }} * 1000));
            }
          },
          stopAutoScroll() {
            if (this.interval) {
              clearInterval(this.interval);
              this.interval = null;
            }
          }
        }
      "
      x-init="startAutoScroll()"
      @mouseenter="stopAutoScroll()"
      @mouseleave="startAutoScroll()"
      @focusin="stopAutoScroll()"
      @focusout="startAutoScroll()"
    >
      <div class="page-width announcement-bar__content">
        {% if visible_count > 1 %}
          <button
            @click="idx = idx === 0 ? total - 1 : idx - 1"
            aria-label="Previous announcement"
            class="announcement-bar__arrow announcement-bar__arrow--prev"
            type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M8.5 1.5L3.5 6L8.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        <div class="announcement-bar__message" aria-live="polite" aria-atomic="true">
          {% assign slide_index = -1 %}
          {% for block in section.blocks %}
            {% liquid
              assign block_market_key = block.type
              if block.type == 'announcement_us' or block.type == 'announcement'
                assign block_market_key = 'us'
              endif
            %}
            {% if block_market_key == announcement_market_type and block.settings.text != blank %}
              {% assign slide_index = slide_index | plus: 1 %}
              <div
                {{ block.shopify_attributes }}
                class="announcement-bar__slide"
                :class="{
                  'announcement-bar__slide--active': idx === {{ slide_index }},
                  'fade-in': idx === {{ slide_index }}
                }"
                :aria-hidden="idx !== {{ slide_index }}"
              >
                <div class="announcement-bar__text announcement-bar__text--desktop">
                  {{ block.settings.text }}
                </div>
                {% if block.settings.text_mobile != blank %}
                  <div class="announcement-bar__text announcement-bar__text--mobile">
                    {{ block.settings.text_mobile }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if visible_count > 1 %}
          <button
            @click="idx = idx === total - 1 ? 0 : idx + 1"
            aria-label="Next announcement"
            class="announcement-bar__arrow announcement-bar__arrow--next"
            type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M3.5 1.5L8.5 6L3.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}
      </div>
    </div>
  </section>

  <script>
    const announcementBar = document.querySelector('#shopify-section-{{ section.id }} .announcement-bar__content');
    if (announcementBar) {
      const setAnnouncementBarHeight = () => {
        document.documentElement.style.setProperty('--announcement-bar-height', `${announcementBar.offsetHeight}px`);
      };

      setAnnouncementBarHeight();

      if ('ResizeObserver' in window) {
        new ResizeObserver(setAnnouncementBarHeight).observe(announcementBar);
      }
    }
  </script>
{% endif %}

