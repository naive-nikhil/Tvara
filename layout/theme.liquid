<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% comment %} Preload fonts {% endcomment %}
    {{ 'articulatcf-bold.static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'articulatcf-reg.static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'base-mono-wide-thin.static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'canela-light-italic.static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'canela-light.static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'canela-thin-static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'geogrotesque-cond-bold.static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'ringside-wide-book-italic.static.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'ringside-wide-book.static.woff2' | asset_url | preload_tag: as: 'font' }}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {%- if settings.splash_screen_enabled -%}
      {% render 'component-splash-screen-head' %}
    {%- endif -%}

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    {% comment %} Load Swiper if on collection, product, or index page {% endcomment %}
    {% if template.name == 'collection' or template.name == 'product' or template.name == 'index' or template.name == 'search'%}
      {{ 'swiper7.4.1.min.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'swiper7.4.1.min.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    {% comment %} Alpine.js — theme-state.js must register alpine:init before Alpine loads {% endcomment %}
    <script src="{{ 'alpine-persist@3.15.12.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme-state.js' | asset_url }}" type="module"></script>
    <script src="{{ 'alpine@3.15.12.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>
    <script src="{{ 'component-cart-form.js' | asset_url }}" type="module"></script>

    <script type="application/json" data-tvara-cart-initial-state>
      {{ cart | json }}
    </script>

    {%- if settings.predictive_search_enabled -%}
      {{ 'component-predictive-search.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
  </head>

  <body>
    <a class="skip-to-content-link visually-hidden" href="#MainContent"> Skip to content </a>

    {%- if settings.splash_screen_enabled -%}
      {% render 'component-splash-screen' %}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'component-predictive-search.js' | asset_url }}" type="module"></script>
    {%- endif -%}

    {%- if settings.splash_screen_enabled -%}
      <script src="{{ 'component-splash-screen.js' | asset_url }}" type="module"></script>
    {%- endif -%}
  </body>
</html>
