{% doc %}
  Renders the slide-out cart drawer with line items, options, totals, and actions.
  Cart line items bind to Alpine.store('cart').

  @example
  {% render 'component-cart-drawer' %}
{% enddoc %}
{{ 'cart.css' | asset_url | stylesheet_tag }}

<cart-drawer
  id="cart-drawer"
  class="color-{{ settings.cart_color_scheme }}"
  :class="{ 'cart-open': cartOpen }"
>
  <button class="drawer-overlay" @click="cartOpen = !cartOpen">
    <span hidden>{{ 'accessibility.close' | t }}</span>
  </button>

  <div class="drawer__wrapper">
    <div x-show="$store.cart.item_count === 0">
      <div class="cart-header cart-header--empty">
        <div class="cart-drawer__close" @click="cartOpen = !cartOpen">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </div>
      </div>
      <div class="cart-empty">
        <div class="cart__empty-content">
          <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
          <a href="{{ routes.all_products_collection_url }}" class="button">
            {{ 'general.continue_shopping' | t }}
          </a>

          {%- if shop.customer_accounts_enabled and customer == null -%}
            <p>{{ 'sections.cart.login.title' | t }}</p>
            <p class="cart__login-paragraph">
              {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
            </p>
          {%- endif -%}
        </div>

        {%- if settings.cart_drawer_collection != blank -%}
          <div class="cart-collection">
            {% assign card_collection = settings.cart_drawer_collection %}
            <a href="{{ card_collection.url }}">
              {{ card_collection.featured_image | image_url: width: 1500 | image_tag }}
              <div class="cart-collection__title">
                {{ card_collection.title }}
              </div>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div x-show="$store.cart.item_count > 0">
      <div class="cart-header">
        <h2>
          {{ 'cart.title' | t }}
          (<span x-text="$store.cart.item_count"></span>)
        </h2>
        <div class="cart-drawer__close" @click="cartOpen = !cartOpen">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </div>
      </div>

      <div class="cart-items">
        {% render 'component-cart-items' %}
      </div>

      <div class="cart-footer">
        {%- if settings.show_cart_note -%}
          <div class="cart-note" x-data="{ noteOpen: false }">
            <label for="CartDrawerNote" :class="{ 'note-open': noteOpen }" @click="noteOpen = !noteOpen">
              {{- 'cart.seller_note' | t -}}
            </label>
            <textarea name="note" form="cart-drawer-form" id="CartDrawerNote">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}

        {% render 'component-cart-discount' %}

        <div>
          {% render 'component-cart-charges' %}

          {% form 'cart', cart, id: 'cart-drawer-form' %}
            <button type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<script src="{{ 'component-cart-quantity.js' | asset_url }}" type="module"></script>
<script src="{{ 'component-cart-drawer.js' | asset_url }}" type="module"></script>
<script src="{{ 'component-cart-discount.js' | asset_url }}" type="module"></script>
