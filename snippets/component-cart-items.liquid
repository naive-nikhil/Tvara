{% comment %}
  Component: Cart Items
  File: snippets/component-cart-items.liquid

  Props: none
  Stores: $store.cart (items, formatMoney, itemProperties, change)
  CSS API: .cart-item, .cart-item__media, .cart-item__details, .cart-quantity
{% endcomment %}

<template x-for="item in $store.cart.items" :key="item.key">
  <div class="cart-item">
    <div class="cart-item__media">
      <template x-if="item.image">
        <img
          :src="item.image"
          :alt="item.product_title"
          width="200"
          height="221"
          loading="lazy"
        >
      </template>
      <template x-if="!item.image">
        {{ 'product-1' | placeholder_svg_tag }}
      </template>
    </div>

    <div class="cart-item__details">
      <div class="cart-item__heading">
        <a :href="item.url" x-text="item.product_title"></a>

        <small class="cart-item__price">
          <template x-if="item.original_price > item.final_price">
            <s x-text="$store.cart.formatMoney(item.original_price)"></s>
          </template>
          <span x-text="$store.cart.formatMoney(item.final_price)"></span>
        </small>

        <dl class="cart-item__options" x-show="item.variant_options?.length || $store.cart.itemProperties(item).length || item.selling_plan_allocation">
          <template x-for="option in item.options_with_values || []" :key="option.name">
            <div class="cart-item__option">
              <dt x-text="`${option.name}:`"></dt>
              <dd x-text="option.value"></dd>
            </div>
          </template>

          <template x-for="prop in $store.cart.itemProperties(item)" :key="prop.name">
            <div class="cart-item__option">
              <dt x-text="`${prop.name}:`"></dt>
              <dd x-text="prop.value"></dd>
            </div>
          </template>
        </dl>

        <p
          class="cart-item__option"
          x-show="item.selling_plan_allocation?.selling_plan?.name"
          x-text="item.selling_plan_allocation?.selling_plan?.name"
        ></p>

        <ul class="cart-discounts" x-show="item.line_level_discount_allocations?.length">
          <template x-for="allocation in item.line_level_discount_allocations" :key="allocation.discount_application.title">
            <li>
              {{- 'icon-discount.svg' | inline_asset_content -}}
              <span x-text="allocation.discount_application.title"></span>
            </li>
          </template>
        </ul>
      </div>

      <div class="cart-item__action">
        <cart-quantity x-bind:data-line-key="item.key">
          <button type="button" data-quantity-minus aria-label="{{ 'products.product.quantity.decrease' | t: product: 'item' }}">
            {{- 'icon-minus.svg' | inline_asset_content -}}
          </button>

          <input
            type="number"
            data-quantity-input
            min="0"
            :value="item.quantity"
            aria-label="{{ 'products.product.quantity.input_label' | t: product: 'item' }}"
          >

          <button type="button" data-quantity-plus aria-label="{{ 'products.product.quantity.increase' | t: product: 'item' }}">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </button>
        </cart-quantity>

        <div class="cart-item__remove">
          {{- 'icon-close.svg' | inline_asset_content -}}
          <button type="button" @click="$store.cart.change(item.key, 0)">
            {{ 'cart.remove' | t }}
          </button>
        </div>
      </div>

      <div class="cart-item__total">
        <template x-if="item.original_line_price != item.final_line_price">
          <s x-text="$store.cart.formatMoney(item.original_line_price)"></s>
          <span x-text="$store.cart.formatMoney(item.final_line_price)"></span>
        </template>
        <template x-if="item.original_line_price == item.final_line_price">
          <span x-text="$store.cart.formatMoney(item.original_line_price)"></span>
        </template>
      </div>
    </div>
  </div>
</template>
